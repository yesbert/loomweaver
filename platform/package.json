{
  "name": "@loomweaver/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev-cert": "node tools/local/dev-cert.mjs",
    "prestart:testbed": "npm run dev-cert",
    "start:testbed": "nx serve loom-testbed --configuration development --host 127.0.0.1 --ssl --ssl-cert .certs/localhost.pem --ssl-key .certs/localhost-key.pem",
    "prepreview:testbed": "npm run dev-cert",
    "preview:testbed": "nx build loom-testbed --configuration production && node tools/local/preview-server.mjs dist/apps/loom-testbed/browser 4300",
    "api-docs-check": "node tools/checks/check-api-docs.mjs",
    "bundle-size-check": "node tools/checks/check-bundle-size.mjs",
    "agent-versions-check": "node tools/checks/check-agent-versions.mjs",
    "quick-start-check": "node tools/checks/check-quick-start.mjs",
    "command-names-check": "node tools/checks/check-command-names.mjs",
    "catalog-keys-check": "node tools/checks/check-catalog-keys.mjs",
    "comments-check": "node tools/checks/check-comments.mjs",
    "generated-output-check": "node tools/checks/check-generated-output.mjs",
    "llms-contract-check": "node tools/checks/check-llms-contract.mjs",
    "icon-docs": "node tools/checks/check-icon-docs.mjs --write",
    "icon-docs-check": "node tools/checks/check-icon-docs.mjs",
    "import-cycles-check": "node tools/checks/check-import-cycles.mjs",
    "package-exports-check": "node tools/checks/check-package-exports.mjs",
    "region-ids-check": "node tools/checks/check-region-ids.mjs",
    "sonar-exclusions-check": "node tools/checks/check-sonar-exclusions.mjs",
    "docs-style-check": "node tools/checks/check-docs-style.mjs",
    "licence-check": "npx --yes license-checker --production --onlyAllow \"$(node -p \"require('../licence-allowlist.json').join(';')\")\" --excludePackages \"@loomweaver/source@0.0.0\"",
    "docs-format-check": "prettier --check '../docs/**/*.md' ../README.md ../CONTRIBUTING.md",
    "structure-check": "node tools/checks/check-structure.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~22.2.4",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/platform-browser-dynamic": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@angular/service-worker": "~22.2.3",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/heroicons": "^36.1.0",
    "@zumer/snapdom": "^3.3.7",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "penpal": "^8.0.1",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@ag-ui/core": "^1.0.3",
    "@angular-devkit/core": "~22.2.4",
    "@angular-devkit/schematics": "~22.2.4",
    "@angular/build": "~22.2.4",
    "@angular/cli": "~22.2.4",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/language-service": "~22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nx/angular": "24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/playwright": "24.0.0",
    "@nx/vite": "24.0.0",
    "@nx/vitest": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/workspace": "24.0.0",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "~22.2.4",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@typescript-eslint/utils": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "jsdom": "^30.1.3",
    "jsonc-eslint-parser": "^3.3.0",
    "ng-packagr": "^22.2.5",
    "nx": "24.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
