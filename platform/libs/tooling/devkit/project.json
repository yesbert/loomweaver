{
  "name": "devkit",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tooling/devkit/src",
  "projectType": "library",
  "tags": ["scope:tooling", "type:tool"],
  "targets": {
    "package": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/tooling/devkit",
        "main": "libs/tooling/devkit/src/index.ts",
        "tsConfig": "libs/tooling/devkit/tsconfig.lib.json",
        "assets": [
          "libs/tooling/devkit/*.md",
          "libs/tooling/devkit/generators.json",
          {
            "glob": "**/schema.json",
            "input": "libs/tooling/devkit/src",
            "output": "src"
          }
        ]
      }
    },
    "typecheck-specs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "cwd": "libs/tooling/devkit",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "test": {
      "dependsOn": ["typecheck-specs"],
      "options": {
        "config": "./vite.config.mts"
      },
      "configurations": {
        "ci": {
          "mode": "coverage"
        }
      }
    }
  }
}
