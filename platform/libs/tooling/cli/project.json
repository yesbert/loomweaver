{
  "name": "cli",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tooling/cli/src",
  "projectType": "library",
  "tags": [
    "scope:tooling",
    "type:tool"
  ],
  "targets": {
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "libs/tooling/cli",
        "command": "node esbuild.mjs"
      }
    },
    "typecheck-specs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "cwd": "libs/tooling/cli",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "test": {
      "dependsOn": ["typecheck-specs"],
      "options": {
        "config": "./vite.config.mts"
      },
      "configurations": {
        "ci": {
          "mode": "coverage"
        }
      },
      "inputs": [
        "default",
        "^production",
        {
          "runtime": "cat ../llms-full.txt ../llms.txt ../README.md ../skills/loomweaver/SKILL.md libs/tooling/*/README.md $(find ../docs -name '*.md' | sort)"
        }
      ]
    }
  }
}
