{
  "name": "cli",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tooling/cli/src",
  "projectType": "library",
  "tags": ["scope:tooling", "type:tool"],
  "targets": {
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "libs/tooling/cli",
        "command": "node esbuild.mjs"
      }
    },
    "test": {
      "options": {
        "config": "./vite.config.mts"
      },
      "configurations": {
        "ci": {
          "mode": "coverage"
        }
      }
    }
  }
}
