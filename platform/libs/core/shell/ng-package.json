{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/libs/core/shell",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "allowedNonPeerDependencies": [
    "dompurify",
    "marked",
    "penpal"
  ],
  "assets": [
    { "input": "src/lib/i18n", "glob": "**/*.json", "output": "i18n" },
    { "input": "src/lib/styles", "glob": "theme.css", "output": "styles" }
  ]
}
