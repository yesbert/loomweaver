{
  "name": "loomweaver-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "npm run lint && npm run test && npm run check-contrast && npm run build && npm run check-head",
    "check-contrast": "node tools/check-contrast.mjs",
    "check-head": "node tools/check-head.mjs",
    "dev": "astro dev",
    "licence-check": "node tools/check-licences.mjs",
    "lint": "eslint .",
    "prebuild": "npm run sync",
    "predev": "npm run sync",
    "preview": "astro preview",
    "sync": "node tools/sync-docs.mjs",
    "test": "node --test \"tools/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
