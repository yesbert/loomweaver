---
import { Code } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PackageManagerTabs from '../components/PackageManagerTabs.astro';
import '../styles/landing.css';
import { mainNav } from '../../nav.mjs';
/* The released version, from the same generated file the structured data reads: the sync copies
   it out of Directory.Build.props, which the bump script writes and the release workflow checks
   against the tag. The line under the headline is therefore true by construction. */
import siteMeta from '../../generated/site-meta.json';

const { version } = siteMeta as { version: string };

const commandExample = `ctx.registerCommand({
  id: 'invoices.export',
  title: 'invoices.export',
  description: 'Export the selected invoices as CSV',
  arguments: [
    { name: 'range', kind: 'choice', choices: ['month', 'quarter', 'year'], required: true },
  ],
  callable: true,
  run: (_context, args) => exportInvoices(String(args?.['range'])),
});`;

const initCommand = 'npx @loomweaver/cli init';

const quickStart = `# a fresh Angular app, or the one you have (an Nx workspace works too)
ng new my-studio --style=css --ssr=false && cd my-studio

# the platform, your product and a first plugin, in one go
npx @loomweaver/cli init

npm start`;

/* The five things a product has before its first plugin, each with the picture the guide shows for
   it. On a wide screen the pictures sit in one panel that stays put while the list scrolls past;
   below that width each picture follows its own entry. */
const highlights = [
  {
    title: 'Panes and tabs',
    text: 'Tab groups the user splits by dragging, preview tabs, pinning, and any tab pops out into a window of its own.',
    shot: 'split-panes',
    anchor: 'panes-and-tabs',
    size: [1920, 1200],
    alt: 'Two panes side by side in a LoomWeaver workbench, each with its own tabs and toolbar',
  },
  {
    title: 'A palette and a quick open',
    text: '⌘K lists every command a plugin registered, with its shortcut. ⌘P finds what is open, and what could be.',
    shot: 'command-palette',
    anchor: 'the-command-palette',
    size: [1880, 1400],
    alt: 'The LoomWeaver command palette open over a dashboard, listing commands contributed by plugins',
  },
  {
    title: 'Workspaces',
    text: 'Named arrangements that remember themselves: the ones you provide, and the ones the user saves.',
    shot: 'workspace-dialog',
    anchor: 'workspaces',
    size: [1920, 1200],
    alt: 'The Workspaces dialog with a provided workspace and one the user saved',
  },
  {
    title: 'A plugin store, with consent',
    text: 'Your curated catalogue. Before a plugin from it runs, the user sees what it asked for and answers once.',
    shot: 'plugin-consent',
    anchor: 'the-plugin-store',
    size: [1920, 1200],
    alt: 'The install prompt for a plugin from the catalogue, listing the two permissions it requests, with Cancel and Install buttons',
  },
  {
    title: 'Settings and permissions',
    text: 'Every plugin’s settings in one place, and every grant the user can inspect and revoke.',
    shot: 'settings',
    anchor: 'settings-and-permissions',
    size: [1920, 1200],
    alt: 'The settings dialog of a LoomWeaver workbench, with a plugin’s section and its permissions',
  },
];

const agents = [
  {
    title: 'Written down for machines',
    text: 'llms.txt is the map, llms-full.txt the whole contract in one fetch. Point any assistant at a URL and it knows the workbench.',
    href: '/llms-full.txt',
    label: 'llms-full.txt',
  },
  {
    title: 'Tools, not guesses',
    text: 'The MCP server gives your assistant the generators and validators as tools. A weaver lands as generator output, not as something to review line by line.',
    href: '/building-with-an-assistant/',
    label: 'Building with an AI assistant',
  },
  {
    title: 'One action, offered to an agent',
    text: 'A command is a rail item, a shortcut and a palette entry. callable: true adds one more caller, and it reaches what the user could have reached, nothing more.',
    href: '/reference/callable-commands/',
    label: 'Callable commands',
  },
  {
    title: 'Driven over AG-UI',
    text: 'An open protocol we implement rather than one we invented. Generate a weaver with --agent and the panel, the seam that decides before a call runs, and a stand-in are there.',
    href: '/ag-ui-agents/',
    label: 'Driving your product with an AG-UI agent',
  },
];

const rungs = [
  {
    name: 'Trusted, in-process',
    body: 'Your own weavers, composed at build time. Full reach, because you wrote them.',
  },
  {
    name: 'Sandboxed iframe',
    body: 'Somebody else’s code in its own JS context, opaque origin, no reach into your DOM. Write the body in any framework.',
  },
  {
    name: 'Installed at runtime',
    body: 'From your curated catalogue, with a consent dialog the user answers and an update path driven by the catalogue version.',
  },
];

const cli = [
  ['distribution', 'a runnable composition root that boots the shell, with its build wired'],
  ['weaver', 'a plugin with a surface, a command, a settings section or an agent connection, as asked'],
  ['theme', 'a token-override stylesheet, editable colours or mapped onto Bootstrap'],
  ['auth-source', 'a stand-in session a user can operate before the real one exists'],
  ['validate-commands', 'per command, whether an agent is offered it and what it would have to guess at'],
];
---

<StarlightPage
  frontmatter={{
    title: 'Open-source plugin platform for Angular workbenches',
    description:
      'An open-source plugin platform for Angular workbenches: panes the user splits, a command palette, theming, and plugins that run sandboxed or install at runtime.',
    template: 'splash',
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <div class="lw-landing">
    <section class="hero">
      <nav class="quick-nav" aria-label="Site">
        {mainNav.map(({ label, link }) => <a href={link}>{label}</a>)}
      </nav>
      <p class="eyebrow">v{version} · Apache 2.0 · frontend only</p>
      <h1>Build Angular workbenches <br />that grow with your product.</h1>
      <p class="lead">
        An open-source plugin platform for Angular workbenches. You write the product; the panes,
        the palette, the theming and a plugin system your users extend are already there.
      </p>
      <div class="command">
        <PackageManagerTabs code={initCommand} id="hero-pm" />
        <p class="hint">In an Angular application or an Nx workspace you already have.</p>
      </div>
      <p class="links quiet">
        <a href="/getting-started/">Get started</a>
        <a href="/overview/">Read the docs</a>
        <a href="https://demo.loomweaver.dev" target="_blank" rel="noopener"
          >Live demo<span class="sr-only"> (opens in a new tab)</span></a
        >
      </p>
    </section>

    <figure class="shot tour">
      <video
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
        poster="/media/tour-dark-poster.jpg"
        width="1280"
        height="800"
        aria-label="A tour of a LoomWeaver workbench: opening the command palette, splitting a pane, a sandboxed non-Angular plugin, and a plugin re-skinning the whole application"
      ></video>
      <figcaption>
        Twenty-seven seconds, no cuts. The rail, the panes, the palette and the status bar are the
        platform’s. Everything inside them can come from plugins, the theme at the end included.
      </figcaption>
      <details class="transcript">
        <summary>What the recording shows, in words</summary>
        <ol>
          <li>A workbench opens with a rail on the left, one document in the content area and a status bar below.</li>
          <li><kbd>⌘K</kbd> opens the command palette; it lists commands from several plugins, and one of them runs.</li>
          <li>A tab is dragged to the right edge and the pane splits, so two documents are open side by side.</li>
          <li>A plugin written without Angular loads into a sidebar, running inside its own sandboxed iframe.</li>
          <li>A theme plugin is switched on and re-skins the entire application, chrome included, without a reload.</li>
        </ol>
      </details>
    </figure>
    <script is:inline>
      // The tour was recorded in both themes, and the sources are set here rather than in the
      // markup so a visitor downloads only the one their theme shows. Starlight resolves "auto"
      // to a concrete data-theme, and the observer follows the switcher without a reload.
      (() => {
        const video = document.querySelector('.tour video');
        if (!video) return;
        const stillness = matchMedia('(prefers-reduced-motion: reduce)');

        const apply = () => {
          const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
          if (video.dataset.tourTheme === theme) return;
          video.dataset.tourTheme = theme;

          const at = video.currentTime;
          video.poster = `/media/tour-${theme}-poster.jpg`;
          video.replaceChildren(
            Object.assign(document.createElement('source'), {
              src: `/media/tour-${theme}.webm`,
              type: 'video/webm',
            }),
            Object.assign(document.createElement('source'), {
              src: `/media/tour-${theme}.mp4`,
              type: 'video/mp4',
            }),
          );
          video.addEventListener('loadedmetadata', () => { video.currentTime = at; }, { once: true });
          video.load();
          if (!stillness.matches) video.play().catch(() => {});
        };

        if (stillness.matches) {
          video.autoplay = false;
          video.pause();
        }
        apply();
        new MutationObserver(apply).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })();
    </script>

    <section class="get">
      <h2>What you get</h2>
      <p class="sub">
        The workbench your users work in, before your first plugin. Every picture is from the live
        demo.
      </p>
      <div class="scrolly">
        <ol class="highlights">
          {
            highlights.map((item, index) => (
              <li data-shot={item.shot} data-index={index}>
                <h3>
                  <a href={`/the-workbench/#${item.anchor}`}>{item.title}</a>
                </h3>
                <p>{item.text}</p>
                <span class="inline-shot">
                  <img
                    class="only-dark"
                    src={`/media/${item.shot}-dark.png`}
                    alt={item.alt}
                    width={item.size[0]}
                    height={item.size[1]}
                    loading="lazy"
                  />
                  <img
                    class="only-light"
                    src={`/media/${item.shot}-light.png`}
                    alt={item.alt}
                    width={item.size[0]}
                    height={item.size[1]}
                    loading="lazy"
                  />
                </span>
              </li>
            ))
          }
        </ol>
        <div class="panel" data-active={highlights[0].shot}>
          {
            highlights.map((item, index) => (
              <figure
                class:list={['frame', { 'is-active': index === 0 }]}
                data-shot={item.shot}
              >
                <img
                  class="only-dark"
                  src={`/media/${item.shot}-dark.png`}
                  alt={item.alt}
                  width={item.size[0]}
                  height={item.size[1]}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <img
                  class="only-light"
                  src={`/media/${item.shot}-light.png`}
                  alt={item.alt}
                  width={item.size[0]}
                  height={item.size[1]}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </figure>
            ))
          }
        </div>
      </div>
      <p class="also">
        Also in the box: theming from semantic tokens, i18n, WCAG 2.1 AA, an installable PWA, live
        sync across windows, and the unsaved-work question. Everything the user does by hand, your
        code can call through the <a href="/distribution-api/">Distribution API</a>. No server:
        settings, state and auth are ports with local defaults, wired to
        <a href="/backend-integration/">your own backend</a> when you are ready.
      </p>
    </section>
    <script is:inline>
      // The panel beside the highlights shows the picture of the entry nearest the middle of the
      // screen, cross-fading between them. Without this script it shows the first one, which is a
      // complete page too.
      (() => {
        const panel = document.querySelector('.get .panel');
        const entries = document.querySelectorAll('.get .highlights > li');
        if (!panel || entries.length === 0 || !('IntersectionObserver' in window)) return;
        const frames = panel.querySelectorAll('.frame');
        const show = (shot) => {
          if (panel.dataset.active === shot) return;
          panel.dataset.active = shot;
          for (const frame of frames) frame.classList.toggle('is-active', frame.dataset.shot === shot);
        };
        const observer = new IntersectionObserver(
          (records) => {
            for (const record of records) {
              if (record.isIntersecting) show(record.target.dataset.shot);
            }
          },
          { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
        );
        for (const entry of entries) observer.observe(entry);
      })();
    </script>

    <section class="feature">
      <div class="feature-text">
        <h2>Still Angular</h2>
        <p class="first">What you write is the Angular you already know, and nothing is written twice.</p>
        <p>
          A weaver is a manifest and one <code>activate()</code>. What it hands the workbench are the
          standalone components you would have written anyway, against Angular’s own router:
          <code>routerLink</code>, <code>ActivatedRoute</code>, guards, back and forward all behave.
          <a href="/reference/routing/#mounting-an-app-that-brings-its-own-routes"
            >One surface can own your whole route tree</a
          >, so an app you already have moves in behind a single plugin.
        </p>
        <p>
          Register an action once and it is a rail item, a keystroke, a context-menu entry and a
          palette entry. You never keep a second list beside the first.
        </p>
        <p class="links">
          <a href="/authoring-a-weaver/">Authoring a weaver</a>
          <a href="/weaver/commands/">Commands and their triggers</a>
        </p>
      </div>
      <Code code={commandExample} lang="ts" title="your weaver" />
    </section>

    <section class="agents">
      <h2>Built for humans and agents</h2>
      <p class="sub">
        Two different things, told apart: an assistant that builds your product, and an agent that
        drives it at runtime.
      </p>
      <div class="card-grid">
        {
          agents.map((card) => (
            <article class="card">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <a href={card.href}>{card.label}</a>
            </article>
          ))
        }
      </div>
      <p class="bridge">
        Somebody who wants to contribute to <em>your</em> tool points their own assistant at your
        <code>llms-full.txt</code> and starts. <strong>Your contributor onboarding is a URL.</strong>
      </p>
      <figure class="shot">
        <img
          class="only-dark"
          src="/media/agent-panel-dark.png"
          alt="A LoomWeaver workbench with a quote open, beside an assistant panel showing the tool call that opened it, the workbench's answer, and a second call that was declined and never ran"
          width="1806"
          height="1389"
          loading="lazy"
        />
        <img
          class="only-light"
          src="/media/agent-panel-light.png"
          alt="A LoomWeaver workbench with a quote open, beside an assistant panel showing the tool call that opened it, the workbench's answer, and a second call that was declined and never ran"
          width="1806"
          height="1389"
          loading="lazy"
        />
        <figcaption>
          The agent opened the quote on the left by calling the same command a menu item calls. The
          second call was declined, and the workbench was never asked to run it.
        </figcaption>
      </figure>
    </section>

    <section class="rungs">
      <h2>Three rungs of trust</h2>
      <p class="sub">One contract, three levels of isolation. Moving a plugin down a rung is a change of trust, not a rewrite.</p>
      <div class="rung-grid">
        {
          rungs.map((rung, index) => (
            <article class="rung">
              <span class="num">{index + 1}</span>
              <h3>{rung.name}</h3>
              <p>{rung.body}</p>
            </article>
          ))
        }
      </div>
      <p class="bridge">
        All three consume the same <code>ctx</code>, behind a default-deny capability broker the user
        can inspect and revoke. <a href="/plugins/">The plugin system</a> has the whole picture.
      </p>
    </section>

    <section class="cli">
      <h2>One CLI</h2>
      <p class="sub">
        The same generators from a command line, as Nx generators, or as tools your assistant calls.
        Each one wires what it finds and names what it could not.
      </p>
      <dl>
        {
          cli.map(([name, what]) => (
            <div>
              <dt>
                <code>{name}</code>
              </dt>
              <dd>{what}</dd>
            </div>
          ))
        }
      </dl>
      <p class="links">
        <a href="/scaffolding/">Scaffolding</a>
        <a href="/samples/">Copyable recipes</a>
      </p>
    </section>

    <section class="cta">
      <h2>Five minutes to a running product</h2>
      <p>
        In a fresh Angular app or the one you have. One command installs the platform, wires the
        build, registers your first weaver, names every file it touched, and only ever adds.
      </p>
      <PackageManagerTabs code={quickStart} id="cta-pm" />
      <div class="actions">
        <a class="btn primary" href="/getting-started/">Get started</a>
        <a class="btn" href="/building-with-an-assistant/">With an AI assistant</a>
        <a class="btn" href="https://demo.loomweaver.dev" target="_blank" rel="noopener"
          >Live demo<span class="sr-only"> (opens in a new tab)</span></a
        >
      </div>
    </section>
  </div>
</StarlightPage>
