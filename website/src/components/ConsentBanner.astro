---
const websiteId = '3cbed8e2-65f2-465d-8414-81a223751f24';
---

<div id="lw-consent-banner" role="region" aria-label="Hinweis zur Webanalyse" style="display:none;">
  <div class="panel">
    <p>
      Wir möchten mit dem datenschutzfreundlichen Analyse-Tool Umami verstehen, wie diese Seite
      genutzt wird: anonym, ohne Cookies und nur mit Ihrer Einwilligung. Mehr dazu in unserer{' '}
      <a href="/datenschutz/">Datenschutzerklärung</a>.
    </p>
    <div class="actions">
      <button type="button" data-consent-decline class="secondary">Ablehnen</button>
      <button type="button" data-consent-accept>Akzeptieren</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ websiteId }}>
  (function () {
    if (window.__lwConsentInit) return;
    window.__lwConsentInit = true;

    const KEY = 'lw-consent';

    function read() {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    }

    function write(value) {
      try {
        localStorage.setItem(KEY, value);
      } catch {}
    }

    function clear() {
      try {
        localStorage.removeItem(KEY);
      } catch {}
    }

    function loadUmami() {
      if (document.querySelector('script[src*="umami"]')) return;
      const script = document.createElement('script');
      script.defer = true;
      script.src = 'https://cloud.umami.is/script.js';
      script.setAttribute('data-website-id', websiteId);
      document.head.appendChild(script);
    }

    function unloadUmami() {
      document.querySelectorAll('script[src*="umami"]').forEach((s) => s.remove());
      try {
        delete window.umami;
      } catch {}
    }

    function setVisible(visible) {
      const banner = document.getElementById('lw-consent-banner');
      if (banner) banner.style.display = visible ? 'flex' : 'none';
    }

    function sync() {
      const consent = read();
      if (consent === 'accepted') loadUmami();
      setVisible(consent !== 'accepted' && consent !== 'declined');
    }

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (target.closest('[data-consent-accept]')) {
        write('accepted');
        loadUmami();
        setVisible(false);
      } else if (target.closest('[data-consent-decline]')) {
        write('declined');
        setVisible(false);
      } else if (target.closest('[data-consent-open]')) {
        setVisible(true);
      } else if (target.closest('[data-consent-revoke]')) {
        clear();
        unloadUmami();
        location.reload();
      }
    });

    document.addEventListener('astro:page-load', sync);
    sync();
  })();
</script>

<style>
  #lw-consent-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 100;
    justify-content: center;
    padding: 1rem;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
    width: 100%;
    max-width: 48rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-bg-nav);
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.25);
  }

  p {
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  button {
    flex: 1;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.375rem;
    background-color: var(--sl-color-accent);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  button.secondary {
    border-color: var(--sl-color-gray-5);
    background-color: transparent;
    color: var(--sl-color-gray-2);
  }

  button:hover {
    opacity: 0.85;
  }

  @media (min-width: 40rem) {
    .panel {
      flex-direction: row;
      align-items: center;
    }

    p {
      flex-grow: 1;
    }

    .actions button {
      flex: none;
    }
  }
</style>
